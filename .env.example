# Copy to .env and fill in. NEVER commit .env.
SYMBOL=BTCUSDT
INTERVAL=1m

# Costs used by backtest + paper broker (basis points per side)
FEE_BPS=10
SLIPPAGE_BPS=2

# Risk limits
MAX_POSITION_USDT=50
DAILY_LOSS_LIMIT_USDT=5
PAPER_START_USDT=1000

# Live trading (off by default). Uses Binance spot TESTNET unless BINANCE_TESTNET=false.
LIVE_TRADING=false
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional LLM judge (any OpenAI-compatible chat endpoint, e.g. Jev or a Claude proxy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Weekly strategy (weekly-live). Budget and total loss limit for the bot, in USDT.
# With 10 coins, each slot is budget/10: keep it >= ~10 USDT (Binance minimum order is 5).
WEEKLY_BUDGET_USDT=20
WEEKLY_MAX_LOSS_USDT=5
